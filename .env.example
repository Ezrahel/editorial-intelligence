GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of the deployed quiz application. This exact URL must also be
# added under Supabase Authentication > URL Configuration.
VITE_APP_URL="https://your-quiz-domain.com"

# Supabase project URL for quiz data and RPC calls.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon key for the frontend client.
VITE_SUPABASE_ANON_KEY="your-anon-key"
